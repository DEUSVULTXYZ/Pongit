{
  "name": "pong-onchain",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev web --hostname 127.0.0.1",
    "build": "npm run contracts:build && npm run abi && npm run abi:v2 && npm run abi:v3 && npm run abi:v4 && npm run abi:rooms:chaos && npm run docs:build && next build web",
    "docs:build": "tsx scripts/docs-build.ts",
    "docs:check": "tsx scripts/docs-build.ts --check",
    "start": "next start web --hostname 0.0.0.0",
    "relayer": "tsx relayer/src/main.ts",
    "contracts:build": "forge build --root contracts",
    "abi": "tsx scripts/abi.ts",
    "typecheck": "tsc --noEmit",
    "test": "forge test --root contracts && tsx --test tests/*.test.ts",
    "test:differential": "tsx scripts/differential.ts",
    "spike": "tsx scripts/spike.ts",
    "deploy": "tsx scripts/deploy.ts",
    "test:e2e": "tsx scripts/e2e.ts",
    "test:tournament": "tsx scripts/e2e-tournament.ts",
    "test:browser": "playwright test",
    "test:recovery": "tsx scripts/recovery.ts",
    "test:backup": "node scripts/backup-check.mjs",
    "test:replay": "tsx scripts/replay-check.ts",
    "benchmark": "tsx scripts/benchmark.ts",
    "benchmark:local": "tsx scripts/benchmark-local.ts",
    "match-cost": "tsx scripts/match-cost.ts",
    "indexer:configure": "tsx scripts/configure-indexer.ts",
    "bootstrap": "node scripts/bootstrap.mjs",
    "abi:v2": "tsx scripts/abi-v2.ts",
    "test:differential:v2": "tsx scripts/differential-v2.ts",
    "test:interlude": "forge test --root contracts --match-contract InterludeLabTest",
    "interlude:probe": "node scripts/interlude-probe.mjs",
    "abi:interlude": "tsx scripts/abi-interlude.ts",
    "abi:rooms": "tsx scripts/abi-rooms.ts",
    "abi:rooms:chaos": "tsx scripts/abi-rooms-chaos.ts",
    "test:rooms": "forge test --root contracts --match-contract InterludeRoomsTest && tsx --test tests/rooms.test.ts",
    "abi:v3": "tsx scripts/abi-v3.ts",
    "abi:v4": "tsx scripts/abi-v4.ts"
  },
  "dependencies": {
    "@category-labs/mera": "0.2.0",
    "@interludelayer-sdk/sdk": "0.1.1",
    "@mdx-js/loader": "3.1.1",
    "@mdx-js/react": "3.1.1",
    "@next/mdx": "16.3.4",
    "@openzeppelin/contracts": "5.4.0",
    "@prb/math": "4.1.0",
    "dotenv": "17.2.3",
    "github-slugger": "2.0.0",
    "next": "16.3.4",
    "pg": "8.16.3",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "rehype-slug": "6.0.0",
    "remark-gfm": "4.0.1",
    "remark-mdx": "3.1.1",
    "remark-parse": "11.0.0",
    "unified": "11.0.5",
    "viem": "^2.38.5",
    "ws": "8.21.3",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@interludelayer-sdk/cli": "0.1.3",
    "@playwright/test": "^1.63.0",
    "@types/mdx": "2.0.14",
    "@types/node": "^22.18.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "ws": "$ws"
  }
}
