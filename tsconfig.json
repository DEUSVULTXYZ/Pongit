{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "Bundler", "strict": true,
    "esModuleInterop": true, "skipLibCheck": true, "resolveJsonModule": true,
    "jsx": "react-jsx", "allowImportingTsExtensions": true, "noEmit": true,
    "plugins": [{ "name": "next" }]
  },
  "include": ["shared/**/*.ts", "relayer/**/*.ts", "scripts/**/*.ts", "tests/**/*.ts", "web/**/*.ts", "web/**/*.tsx"],
  "exclude": ["node_modules", "indexer/generated", "web/.next"]
}
