CHAIN_ID=10143
RPC_URL=https://rpc.ankr.com/monad_testnet
RPC_SPACING_MS=60
# Optional future paid/service integration: https://monad-testnet.g.alchemy.com/v2/YOUR_KEY
ALCHEMY_RPC_URL=
RPC_FALLBACK_URL=
RELAYER_PRIVATE_KEY=
DEPLOYER_PRIVATE_KEY=
ADMIN_ADDRESS=
TREASURY_ADDRESS=
DEPLOYMENT_FILE=deployments/testnet.json
DATABASE_URL=postgres://pong:CHANGE_ME@localhost:5432/pong
PORT=4000
ALLOWED_ORIGIN=http://localhost:3000
# Zero disables the daily spending ceiling; balance and abuse controls still apply.
RELAYER_DAILY_BUDGET_MON=0
RELAYER_MAX_GAS_PRICE_GWEI=200
RELAYER_MIN_BALANCE_MON=0.01
RELAYER_QUEUE_LIMIT=500
MARKET_LIQUIDITY_MON=0.01
FAUCET_CREDIT_MON=0.02
TRUST_PROXY=false
LOCAL_DEV=false
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000/ws
NEXT_PUBLIC_RP_ID=localhost
ENVIO_API_TOKEN=
HASURA_ADMIN_SECRET=
INDEXER_GRAPHQL_URL=http://localhost:8080/v1/graphql
PONG_DOMAIN=pongit.xyz
INDEXER_RPC_URL=http://rpc-indexer:8545
INDEXER_CHUNKED_RPC=true
INDEXER_DATABASE=pong_indexer_v4_1ff69df6_scoped
POSTGRES_PASSWORD=
RELAYER_DB_PASSWORD=
INDEXER_DB_PASSWORD=
# Separate funded testnet account; never use a production key.
BENCHMARK_PRIVATE_KEY=
BENCHMARK_TXS=100
BENCHMARK_TPS=5
BENCHMARK_MAX_MON=12
# Rooms stay gated until same-app delegation renewal is validated.
PONG_ROOMS_HOME=false
ROOMS_ADMISSION_ENABLED=false
INTERLUDE_COORDINATOR_KEY=
INTERLUDE_ROOMS_MANIFEST=deployments/interlude-rooms.json
ROOMS_CHAOS_ENABLED=false
ROOMS_FINANCE_MANIFEST=deployments/rooms-finance.json
ROOMS_SECRET_DIRECTORY=/opt/pongit/secrets/rooms
ROOMS_PRESSURE_KEY_FILE=/run/pongit-rooms/pressure.json
ROOMS_LIFECYCLE_KEY_FILE=/run/pongit-rooms/lifecycle.json
# Gas limit of every game-node command, relayer and browser (served by /api/interlude/config).
# Empty means 30000000, the node maximum. Set 15000000 if the node reports "gas limit is
# greater than the cap" (ENGINE_GAS_CAP), then restart the relayer; no rebuild is needed.
ROOMS_ENGINE_COMMAND_GAS=
# Drain and renew once the epoch has committed this many batches (empty: 600, at most 1000).
# The stake release replays every batch in one block; see docs/AGENT_ARCADE.md.
ROOMS_LIFECYCLE_MAX_BATCHES=
# Candidate only. Keep disabled until hosted multi-batch qualification passes.
PONG_INDEPENDENT_HOME=false
PONG_INDEPENDENT_ADMISSION=false
PONG_INDEPENDENT_MANIFEST=
PONG_INDEPENDENT_SNAPSHOT=
PONG_PROFILE_MIGRATION_FREEZE=false
